# URL base de la API del backend para la aplicación SBE
# Puedes crear un archivo .env en la raíz de este proyecto y definir esta variable.
# Si no se define, se utilizará el valor por defecto configurado en src/api/config.ts

# Para emulador Android (apuntando al localhost de tu PC):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Para dispositivo físico en la misma red Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.1.X:3000/api

# Para web o simulador iOS:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Para producción / staging:
EXPO_PUBLIC_API_URL=https://api.sbe.unse.edu.ar/api
